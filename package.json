{
  "name": "rsbuild-react-bun-biome-starter-template",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "bun build src/index.html --outdir dist/",
    "check": "bun run check:tsc && bun run check:format",
    "check:format": "biome check --write",
    "check:tsc": "tsc --noEmit",
    "dev": "bun --watch src/index.html",
    "format": "biome format --write",
    "preview": "bun run build && bun dist/index.html",
    "test:e2e": "./scripts/e2e-tests",
    "test:unit": "bun test"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "es-toolkit": "1.52.0",
    "prosekit": "0.22.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.63.0",
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.4.2",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
