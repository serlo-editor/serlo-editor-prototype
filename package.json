{
  "name": "rsbuild-react-bun-biome-starter-template",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "bun build src/index.html --outdir dist/",
    "check": "bun run check:tsc && bun run test:unit && bun run check:format && bun run check:lint",
    "check:format": "oxfmt --check",
    "check:lint": "oxlint",
    "check:tsc": "tsc --noEmit",
    "fix": "bun run fix:lint && bun run fix:format && bun run check",
    "fix:format": "oxfmt",
    "fix:lint": "oxlint --fix",
    "dev": "bun --watch src/index.html",
    "format": "oxfmt",
    "preview": "bun run build && bun dist/index.html",
    "test": "bun run test:unit && bun run test:e2e",
    "test:e2e": "./scripts/e2e-tests",
    "test:unit": "bun test"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "es-toolkit": "1.52.0",
    "prosekit": "0.22.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.4.2",
    "@types/react-dom": "19.3.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "7.0.2"
  }
}
